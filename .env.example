# LLM Configuration
# Choose provider: openai, anthropic, or google
LLM_PROVIDER=google
LLM_API_KEY=your_llm_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
LLM_MODEL=gemini-1.5-flash
LLM_BASE_URL=https://api.openai.com/v1

# TigerGraph Configuration
TG_HOST=localhost
TG_PORT=14240
TG_SECRET=your_tigergraph_secret_here
TG_GRAPHNAME=Transaction_Fraud

# Vector Database Configuration
VECTOR_DB_PATH=./data/vector_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Data Configuration
DATA_PATH=./data
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=5

# Agent Configuration
MAX_AGENT_ITERATIONS=10
EVIDENCE_SUFFICIENCY_THRESHOLD=0.8
MAX_TOKEN_BUDGET=10000

# Benchmark Configuration
BENCHMARK_OUTPUT_PATH=./evaluation/results
MAX_CONCURRENT_BENCHMARKS=3
