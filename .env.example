# LLM Configuration
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# TigerGraph Configuration
TIGERGRAPH_HOST=localhost
TIGERGRAPH_PORT=14240
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=tigergraph
TIGERGRAPH_GRAPH=graphrag_hackathon

# Vector Database Configuration
VECTOR_DB_PATH=./data/vector_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Data Configuration
DATA_PATH=./data
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=5

# Agent Configuration
MAX_AGENT_ITERATIONS=10
EVIDENCE_SUFFICIENCY_THRESHOLD=0.8
MAX_TOKEN_BUDGET=10000

# Benchmark Configuration
BENCHMARK_OUTPUT_PATH=./evaluation/results
MAX_CONCURRENT_BENCHMARKS=3
